# Local development defaults. Copy to .env and adjust.
# Generate a real production key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Use config.settings.development for local or config.settings.production for production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite works out of the box for local dev:
DATABASE_URL=sqlite:///db.sqlite3
# Postgres for staging/production (e.g. Neon, Supabase, RDS):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# Comma-separated allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production security & static file hosting:
# WhiteNoise automatically serves static files when DJANGO_SETTINGS_MODULE=config.settings.production.
# Run: python manage.py collectstatic --no-input

# --- Payments (PayMongo / Mock) ---
PAYMENTS_PROVIDER=mock
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173

# --- Media Storage (Cloudinary / Local) ---
# Set MEDIA_STORAGE_PROVIDER=cloudinary to upload product images to Cloudinary.
# Leave as local for offline development without Cloudinary credentials.
MEDIA_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
CLOUDINARY_UPLOAD_FOLDER=studio/products
MEDIA_MAX_UPLOAD_SIZE_MB=8

# --- Transactional Emails (Mock / Resend / SMTP) ---
# Set EMAIL_PROVIDER=resend or EMAIL_PROVIDER=smtp to deliver live emails.
# Leave as mock for local testing/development without credentials.
EMAIL_PROVIDER=mock
DEFAULT_FROM_EMAIL=Studio Atelier <concierge@studio-atelier.ph>
RESEND_API_KEY=

