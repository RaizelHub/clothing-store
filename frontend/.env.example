# Leave unset in local dev — Vite proxies /api to Django (see vite.config.ts).
# Set explicitly in production to your deployed API, e.g.:
# VITE_API_URL=https://api.yourstore.com/api
VITE_API_URL=

# Mock API switch. Defaults to ON ("true") — every request is served in-browser
# by src/mocks/adapter.ts against a localStorage-seeded catalog, so the whole
# storefront works with no backend. Set to "false" once the Django API is up:
# the same axios client then hits the real DRF endpoints directly.
# VITE_USE_MOCKS=true